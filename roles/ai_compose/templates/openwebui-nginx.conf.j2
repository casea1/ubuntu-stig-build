# Managed by ansible (ai_compose) -- do not edit by hand.
# Reverse proxy in front of Open WebUI. Captured as-built from dev-ai1 on
# 2026-09-21; only the allow-lists are templated (ai_openwebui_allow_cidrs).
#
# This proxy is now the ONLY thing publishing 3000 and 8050 -- the open-webui
# container itself publishes nothing -- so this allow-list is the only thing
# restricting the UI. It has to live here rather than in ufw: Docker publishes
# container ports with its own DNAT rules, evaluated BEFORE ufw's INPUT chain,
# so ufw cannot filter a published port at all. Same reasoning as the MLflow
# proxy next door.
user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  2048;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'cache:$upstream_cache_status';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size 2048;

    # Static asset cache. Sized for an air-gapped box: 50MB index (~8,000 files),
    # 500MB on disk, 30-day retention. nginx-cache is a local compose volume, so
    # the cache survives a restart but not a `down -v`.
    proxy_cache_path /var/cache/nginx/static
        levels=1:2
        keys_zone=static_cache:50m
        max_size=500m
        inactive=30d
        use_temp_path=off;

    # open-webui is a SINGLE container running 9 uvicorn workers, so a literal
    # upstream name is correct here -- unlike the MLflow proxy, where the service
    # is replicated and the name has to be re-resolved through Docker's DNS.
    upstream open_webui_backend {
        server open-webui:8080 max_fails=3 fail_timeout=30s;
        keepalive 16;
        keepalive_requests 1000;
        keepalive_timeout 75s;
    }

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        application/xml
        image/svg+xml;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Main web interface (port 3000)
    server {
        listen 3000;
        server_name _;

{% for cidr in ai_openwebui_allow_cidrs | default([]) %}
        allow {{ cidr }};
{% endfor %}
        deny  all;

        location ~* ^/static/|\.(?:css|js|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
            proxy_pass http://open_webui_backend;

            proxy_cache static_cache;
            proxy_cache_valid 200 30d;
            proxy_cache_valid 404 5m;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 5s;

            add_header X-Cache-Status $upstream_cache_status;
            add_header Cache-Control "public, immutable";
            expires 30d;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout 10s;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location ~* ^/(?:api|auth|v1)/ {
            proxy_pass http://open_webui_backend;
            proxy_cache_bypass 1;
            proxy_no_cache 1;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_buffering on;
            proxy_buffer_size 16k;
            proxy_buffers 8 16k;
            proxy_busy_buffers_size 32k;

            proxy_connect_timeout 10s;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location ~* ^/(?:upload|files)/ {
            client_max_body_size 0;          # RAG document uploads are uncapped
            proxy_pass http://open_webui_backend;
            proxy_cache_bypass 1;
            proxy_no_cache 1;
            proxy_request_buffering off;     # stream large uploads

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout 10s;
            proxy_read_timeout 1800s;
            proxy_send_timeout 1800s;
        }

        location /health {
            proxy_pass http://open_webui_backend;
            proxy_cache_bypass 1;
            proxy_no_cache 1;
            access_log off;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
        }

        location /ws {
            proxy_pass http://open_webui_backend;
            proxy_cache_bypass 1;
            proxy_no_cache 1;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout 10s;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location / {
            proxy_pass http://open_webui_backend;

            proxy_cache static_cache;
            proxy_cache_valid 200 1m;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            add_header X-Cache-Status $upstream_cache_status;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_buffering on;
            proxy_buffer_size 16k;
            proxy_buffers 8 16k;
            proxy_busy_buffers_size 32k;

            proxy_connect_timeout 10s;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }
    }

    # Alternative port (8050), same allow-list.
    server {
        listen 8050;
        server_name _;

{% for cidr in ai_openwebui_allow_cidrs | default([]) %}
        allow {{ cidr }};
{% endfor %}
        deny  all;

        location / {
            proxy_pass http://open-webui:8050;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_buffering on;
            proxy_buffer_size 16k;
            proxy_buffers 8 16k;
            proxy_busy_buffers_size 32k;

            proxy_connect_timeout 10s;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }
    }
}

#!/bin/sh
# Managed by usg_remediate -- do not edit by hand.
# Weekly offload of the audit trail (AU-4(1) / UBTU-24-900240).
#
# Three stages, each independent and each optional:
#   1. AUDIT   stage the rotated auditd logs as audit-<host>-<date>.tar.gz
#   2. EXTRA   stage other log sources (container logs, app audit trails) as a
#              SEPARATE logs-<host>-<date>.tar.gz -- deliberately not mixed into
#              the audit archive, so the AU-4 artifact an assessor opens holds
#              the audit trail and nothing else
#   3. PUSH    copy both to a remote share
#
# THE LOCAL COPY IS ALWAYS KEPT, even when the push succeeds. A share that is
# unreachable, full, or misconfigured must never be the reason an audit trail
# went missing -- so the push is a copy, not a move, and its failure is loud
# but not destructive.
set -eu

SRC=/var/log/audit
DEST={{ usg_audit_offload_dir }}
KEEP={{ usg_audit_offload_keep }}
LOG=/var/log/audit-offload.log

log() { printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"; }
{% if usg_audit_offload_command | default('') | length > 0 %}

# usg_audit_offload_command REPLACES everything above. Kept for a site that
# already pushes to a syslog/SIEM host its own way.
{{ usg_audit_offload_command }}
exit $?
{% else %}

install -d -m 0750 -o root "$DEST"
stamp=$(date +%Y%m%d)
host=$(hostname -s)

# ---- 1. the audit trail ----------------------------------------------------
if [ -d "$SRC" ]; then
  set -- "$SRC"/audit.log.*
  if [ -e "$1" ]; then
    out="$DEST/audit-$host-$stamp.tar.gz"
    # Only the ROTATED logs: audit.log itself is open and being written.
    if tar -czf "$out.tmp" -C "$SRC" -- $(cd "$SRC" && ls audit.log.*) 2>>"$LOG"; then
      mv -f "$out.tmp" "$out"; chmod 0640 "$out"
      log "audit archive: $out"
    else
      rm -f "$out.tmp"; log "ERROR: audit archive failed"
    fi
  fi
fi

{% if (usg_audit_offload_containers | default(false) | bool) or (usg_audit_offload_extra | default([]) | length > 0) %}
# ---- 2. everything else ----------------------------------------------------
# Container stdout/stderr is NOT in /var/log and NOT in journald: the daemon
# runs the json-file driver, so it lives under /var/lib/docker capped at
# 30 MB per container and is then discarded. Nothing collected it. Same for
# an application audit trail written inside a container's volume.
extra_tmp=$(mktemp -d /tmp/offload-extra.XXXXXX) || extra_tmp=""
if [ -n "$extra_tmp" ]; then
{% if usg_audit_offload_containers | default(false) | bool %}
  # `docker logs` rather than reaching into /var/lib/docker: it is the supported
  # interface, works whatever log driver is set, and names files by CONTAINER
  # rather than by the 64-char id the on-disk files use.
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    mkdir -p "$extra_tmp/containers"
    for c in $(docker ps -a --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null); do
{% if (usg_audit_offload_container_names | default([]) | length) > 0 %}
      case " {{ usg_audit_offload_container_names | join(' ') }} " in
        *" $c "*) ;;
        *) continue ;;
      esac
{% endif %}
      docker logs --timestamps "$c" > "$extra_tmp/containers/$c.log" 2>&1 || true
    done
    log "container logs: $(ls -1 "$extra_tmp/containers" 2>/dev/null | wc -l) container(s)"
  else
    log "WARNING: docker not available -- container logs NOT collected"
  fi
{% endif %}
{% for p in usg_audit_offload_extra | default([]) %}
  # {{ p }}
  for f in {{ p }}; do
    [ -r "$f" ] || { log "WARNING: unreadable, not collected: $f"; continue; }
    mkdir -p "$extra_tmp/files"
    cp -p "$f" "$extra_tmp/files/$(printf '%s' "$f" | tr '/' '_')" 2>>"$LOG" \
      && log "extra: $f" || log "ERROR: could not copy $f"
  done
{% endfor %}
  if [ -n "$(ls -A "$extra_tmp" 2>/dev/null)" ]; then
    lout="$DEST/logs-$host-$stamp.tar.gz"
    tar -czf "$lout.tmp" -C "$extra_tmp" . 2>>"$LOG" \
      && { mv -f "$lout.tmp" "$lout"; chmod 0640 "$lout"; log "logs archive: $lout"; } \
      || { rm -f "$lout.tmp"; log "ERROR: logs archive failed"; }
  fi
  rm -rf "$extra_tmp"
fi
{% endif %}

{% if usg_audit_offload_sftp_enabled | default(false) | bool %}
# ---- 3. push over SFTP -----------------------------------------------------
# WHY NOT SMB HERE. On a FIPS box there is no SMB path to a file server that is
# not domain-joined: NTLMv2 is built on MD5, FIPS removes MD5 from the kernel
# crypto API, and sec=none does not avoid it because SMB2/3 carries even an
# anonymous session over NTLMSSP. Tested at every dialect against the deployed
# server. SSH crypto is FIPS-approved and needs no KDC, so the AU-4 trail moves
# today instead of waiting for the domain controller.
#
# No mount: scp straight to the server. There is nothing to leave mounted, no
# boot-time dependency, and no path onto this box if the server is compromised.
SFTP_DEST='{{ usg_audit_offload_sftp_dest }}'
SFTP_KEY='{{ usg_audit_offload_sftp_key }}'
SFTP_PORT='{{ usg_audit_offload_sftp_port | default(22) }}'
SFTP_SUB='{{ usg_audit_offload_sftp_subdir | default('') }}'
SFTP_KNOWN='{{ usg_audit_offload_sftp_known_hosts | default('/etc/stig-build/ssh/known_hosts') }}'

push_failed=0
if [ ! -r "$SFTP_KEY" ]; then
  log "ERROR: no SSH key at $SFTP_KEY -- push SKIPPED, local copy kept"
  push_failed=1
elif [ ! -r "$SFTP_KNOWN" ]; then
  # StrictHostKeyChecking stays ON. An unattended job that trusts whatever
  # answers on port 22 is a man-in-the-middle waiting to happen, and the point
  # of this transport is that it is the compliant one.
  log "ERROR: no pinned host key at $SFTP_KNOWN -- push SKIPPED, local copy kept"
  log "       pin it with: it-sshfs add, or ssh-keyscan -H <host> >> $SFTP_KNOWN"
  push_failed=1
else
  ssh_opts="-o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=yes"
  ssh_opts="$ssh_opts -o UserKnownHostsFile=$SFTP_KNOWN -i $SFTP_KEY -P $SFTP_PORT"
  # user@host:/path -> split so a subdirectory can be created before the copy
  sftp_user_host="${SFTP_DEST%%:*}"
  sftp_path="${SFTP_DEST#*:}"
  [ -n "$SFTP_SUB" ] && sftp_path="$sftp_path/$SFTP_SUB"

  # mkdir -p has no sftp equivalent; `-mkdir` in a batch is allowed to fail, and
  # an existing directory failing is the normal case, not an error.
  printf 'mkdir %s\nquit\n' "$sftp_path" | \
    sftp -q $ssh_opts "$sftp_user_host" >/dev/null 2>&1 || true

  for f in "$DEST"/audit-"$host"-"$stamp".tar.gz "$DEST"/logs-"$host"-"$stamp".tar.gz; do
    [ -f "$f" ] || continue
    if printf 'put %s\nquit\n' "$f" | \
       sftp -q $ssh_opts "$sftp_user_host:$sftp_path" >>"$LOG" 2>&1; then
      log "pushed: $(basename "$f") -> $SFTP_DEST/$SFTP_SUB"
    else
      log "ERROR: SFTP push failed for $(basename "$f")"
      push_failed=1
    fi
  done
fi
{% elif usg_audit_offload_smb_enabled | default(false) | bool %}
# ---- 3. push to the share --------------------------------------------------
# Mounted ON DEMAND and unmounted straight after. A share left permanently
# mounted is a path onto the box and a boot-time dependency on a server that
# may not be there.
SMB_SHARE='{{ usg_audit_offload_smb_share }}'
SMB_CRED='{{ usg_audit_offload_smb_credentials }}'
SMB_OPTS='{{ usg_audit_offload_smb_options }}'
SMB_SUB='{{ usg_audit_offload_smb_subdir }}'
SMB_AUTH='{{ usg_audit_offload_smb_auth | default('creds') }}'
MNT=/run/audit-offload.mnt

# Guest is sec=none, overriding whatever SMB_OPTS carries.
#
# `guest` alone only means "send no username or password" -- the client still
# performs the session setup sec= asks for, and the default is sec=ntlmssp. On
# a FIPS box that cannot work: NTLMv2 needs HMAC-MD5, which FIPS removes from
# the kernel crypto API. The mount fails with "Could not allocate shash TFM
# 'hmac(md5)'" and ENOENT -- indistinguishable from a missing share.
if [ "$SMB_AUTH" = guest ]; then
  mount_opts="guest,sec=none,$(printf '%s' "$SMB_OPTS" | sed -E 's/(^|,)sec=[^,]*//g; s/^,//')"
else
  mount_opts="credentials=$SMB_CRED,$SMB_OPTS"
fi

push_failed=0
if [ "$SMB_AUTH" != guest ] && [ ! -r "$SMB_CRED" ]; then
  log "ERROR: no credentials file at $SMB_CRED -- push SKIPPED, local copy kept"
  push_failed=1
elif ! command -v mount.cifs >/dev/null 2>&1; then
  log "ERROR: cifs-utils not installed -- push SKIPPED, local copy kept"
  push_failed=1
else
  mkdir -p "$MNT"
  if mount -t cifs "$SMB_SHARE" "$MNT" -o "$mount_opts" 2>>"$LOG"; then
    dst="$MNT/$SMB_SUB"
    if mkdir -p "$dst" 2>>"$LOG"; then
      for f in "$DEST"/audit-"$host"-"$stamp".tar.gz "$DEST"/logs-"$host"-"$stamp".tar.gz; do
        [ -f "$f" ] || continue
        cp -p "$f" "$dst/" 2>>"$LOG" && log "pushed: $(basename "$f") -> $SMB_SHARE/$SMB_SUB" \
          || { log "ERROR: push failed for $(basename "$f")"; push_failed=1; }
      done
    else
      log "ERROR: cannot create $dst on the share"; push_failed=1
    fi
    umount "$MNT" 2>>"$LOG" || log "WARNING: umount $MNT failed"
  else
    log "ERROR: could not mount $SMB_SHARE -- push SKIPPED, local copy kept"
    push_failed=1
  fi
fi
{% endif %}

# ---- retention -------------------------------------------------------------
# Only ever prunes archives this script wrote, and only the LOCAL copies.
for pat in "audit-" "logs-"; do
  ls -1t "$DEST/$pat"*.tar.gz 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r old; do
    rm -f -- "$old"
  done
done

chmod 0640 "$LOG" 2>/dev/null || true
{% if usg_audit_offload_smb_enabled | default(false) | bool %}
# Non-zero so cron mails root / the run shows as failed. The trail is safe
# locally either way -- this says the OFFLOAD did not complete.
[ "$push_failed" -eq 0 ] || exit 1
{% endif %}
exit 0
{% endif %}

# Managed by ansible (clamav_container) -- do not edit by hand.
#
# clamd in a container, because the host's ClamAV cannot initialise MD5 under
# FIPS and therefore detects nothing (Cisco-Talos/clamav#1786). The image ships a
# stock OpenSSL, so MD5 works inside. The host kernel stays in FIPS mode.
#
# Two mount details are load-bearing, both from docs.clamav.net Docker manual:
#   - the image's clamd listens on /tmp/clamd.sock, so the socket directory is
#     bind-mounted over the container's /tmp (which is also where clamd puts
#     scan temp files -- bounded by MaxScanSize).
#   - the database directory must be WRITABLE: the entrypoint chowns it to the
#     container's clamav user. Hence a dedicated copy, not the host's.
#
# Scans arrive over the socket as file DESCRIPTORS (clamdscan --fdpass), so
# nothing being scanned is ever mounted in and the daemon reads with the calling
# user's rights.
[Unit]
Description=ClamAV daemon (containerised -- host engine cannot scan under FIPS)
Documentation=https://github.com/Cisco-Talos/clamav/issues/1786
Documentation=https://docs.clamav.net/manual/Installing/Docker.html
After=docker.service
Requires=docker.service

[Service]
Type=exec
Restart=on-failure
RestartSec=10s
TimeoutStartSec=600
ExecStartPre=-/usr/bin/docker rm -f clamav-container
# {{ clamav_container_sock_dir }} is on tmpfs, so it is GONE after a reboot and
# the next ansible-pull may be days away. The unit has to create it itself, with
# /tmp's permissions: clamd runs as the image's unprivileged clamav user and
# binds its socket in here. At 0755 root:root it cannot, and the only symptom is
# "Socket file /tmp/clamd.sock could not be bound: Permission denied" in a log
# nobody reads.
ExecStartPre=/usr/bin/install -d -m 1777 -o root -g root {{ clamav_container_sock_dir }}
ExecStart=/usr/bin/docker run --rm --name clamav-container \
  --memory {{ clamav_container_memory }} \
  --network none \
  --security-opt no-new-privileges \
  -e CLAMAV_NO_FRESHCLAMD=true \
  -e CLAMAV_NO_MILTERD=true \
  -e CLAMD_STARTUP_TIMEOUT=600 \
  -v {{ clamav_container_sock_dir }}:/tmp \
  -v {{ clamav_container_db_dir }}:/var/lib/clamav \
  {{ clamav_container_image }}
ExecStop=/usr/bin/docker stop -t 30 clamav-container

[Install]
WantedBy=multi-user.target

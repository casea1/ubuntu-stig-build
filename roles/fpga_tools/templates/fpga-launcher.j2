#!/usr/bin/env bash
# {{ item.cmd }} -- launcher for {{ item.name }}.
#
# Managed by the fpga_tools role -- do not edit by hand.
#
# The vendor tools are NOT on everyone's PATH: settings64.sh prepends a large
# PATH and LD_LIBRARY_PATH, and having that in every login shell on the box --
# including for users who never touch an FPGA -- has broken unrelated system
# tools. This wrapper gives the one command without that cost, and is what the
# app-grid entry runs.
#
# NO `set -u`. This sources a VENDOR script, and settings64.sh dereferencing an
# unset variable would abort the launcher instead of starting the tool.

ROOT="{{ item.root }}"
BIN="{{ item.bin }}"

# Three different problems with one symptom, and naming the wrong one sends
# someone hunting for hours. Note that a user who cannot TRAVERSE the tree gets
# a false answer from `-e`, so "does not exist" is never assumed on its own.
msg=""
if [ ! -d "$ROOT" ]; then
  msg="{{ item.name }} is not installed.
Nothing is under $ROOT.
Check with: sudo it-fpga status"
elif [ ! -e "$BIN" ]; then
  msg="{{ item.name }} cannot be reached at:
    $BIN
Either it is not installed, a different version is (this launcher is built for
the version the pull is configured with), or this account cannot traverse the
install tree -- which looks identical from here.
Check with: sudo it-fpga status"
elif [ ! -x "$BIN" ] || [ ! -r "$BIN" ]; then
  msg="{{ item.name }} is installed, but this account cannot use it.
Access is granted by the '{{ access_group }}' group:
    id -nG        should list {{ access_group }}
An administrator adds you with:
    sudo usermod -aG {{ access_group }} <user>     then log out and back in
If you ARE in the group, the install tree permissions are wrong -- the STIG's
umask 077 does that to any installer run under sudo:
    sudo it-fpga fixup"
fi

# ONE reporting path for all of them. Having this inside a branch is how the
# first version failed silently and then ran exec anyway.
if [ -n "$msg" ]; then
  # BOTH stderr and a dialog, not either: from the app grid there is no
  # terminal, and if the dialog tools are missing too then a stderr-only
  # message goes nowhere and the icon just looks broken.
  printf '%s\n' "$msg" >&2
  if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    if command -v zenity >/dev/null 2>&1; then
      zenity --error --no-wrap --title="{{ item.name }}" --text="$msg" 2>/dev/null
    elif command -v notify-send >/dev/null 2>&1; then
      notify-send -u critical "{{ item.name }}" "$msg" 2>/dev/null
    elif command -v xmessage >/dev/null 2>&1; then
      xmessage -center "$msg" 2>/dev/null
    fi
  fi
  exit 1
fi
{% if item.settings is defined %}

# shellcheck disable=SC1090
[ -r "{{ item.settings }}" ] && . "{{ item.settings }}"
{% endif %}
{%- if item.ld_i386 | default(false) %}

# Libero and Synplify carry 32-bit components, and need old RHEL-era libraries
# Ubuntu does not package. Both are private to this process.
export LD_LIBRARY_PATH="{{ compat_dir }}:/usr/lib/i386-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
{%- endif %}

exec "$BIN" "$@"

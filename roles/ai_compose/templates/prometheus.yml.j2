# Managed by ansible (ai_compose) -- do not edit by hand; edit the template.
# Scrapes the vLLM/docling /metrics endpoints. The LGTM stack has its own
# Prometheus for OTLP-pushed metrics; this one PULLS from services that only
# expose a scrape endpoint.
global:
  scrape_interval: 10s
  evaluation_interval: 10s

scrape_configs:
  # System 1's chat model, across the LAN. ai_system1_addr, so `it-set-ip --peer`
  # renumbers it with everything else.
  - job_name: 'vllm-metrics'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['{{ ai_system1_addr | default("dev-ai1") }}:8000']

  # Local, over the `oi` network.
  - job_name: 'vllm-metrics-embed'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['vllm-embed:8002']

  - job_name: 'docling-metrics'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['docling-serve:5001']
